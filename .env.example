# Copier en .env.local pour surcharger.
# Adresse de l'API Symfony utilisée par le proxy de dev (vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8090
# Préfixe des appels API côté navigateur (laisser /api en dev grâce au proxy).
VITE_API_BASE_URL=/api
# Journal communautaire : "local" (stockage dans le navigateur, par défaut) ou "api" (/api/community_posts).
VITE_COMMUNITY_BACKEND=local
# Demandes d'aide (SAV) : "local" (par défaut) ou "api" (/api/support_requests).
VITE_SUPPORT_BACKEND=local
