# Copier en .env.local pour surcharger.
# Adresse de l'API Symfony utilisée par le proxy de dev (vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8090
# Préfixe des appels API côté navigateur (laisser /api en dev grâce au proxy).
VITE_API_BASE_URL=/api
# Journal communautaire : "api" (/api/community_posts, par défaut) ou "local" (stockage dans le navigateur, démo sans back).
VITE_COMMUNITY_BACKEND=api
# Demandes d'aide (SAV) : "api" (/api/support_requests, par défaut) ou "local".
VITE_SUPPORT_BACKEND=api
